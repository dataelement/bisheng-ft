# The host GPU index allocated by your administrator; inspect it with nvidia-smi.
GPU_ID=0
FT_PORT=8000
# Use the server's private IP here when Bisheng is on another host.
FT_BIND_IP=127.0.0.1
# Relative paths below are resolved from deploy/multimodal.
MODEL_DIR=./data/models
OUTPUT_DIR=./data/jobs
# Comma-separated registered model directory names. Empty exposes all installed models.
FT_MODELS=Qwen3-0.6B,Qwen2.5-VL-3B-Instruct
HF_ENDPOINT=https://huggingface.co

# Model templates, modalities, validation status and training parameter schema.
CAPABILITIES_FILE=../../src/sft_server/model_capabilities.json
